# Normalise line endings
* text=auto eol=lf

# The contract witness is regenerated from the projector, never hand-edited — collapse it
# in review diffs so the change that produced it stays readable.
/tests/OpenApi/Fixture/contract-witness.json linguist-generated=true

# Exclude development & meta files from the Composer dist archive
/.github/                export-ignore
/bin/                    export-ignore
/docs/                   export-ignore
/tests/                  export-ignore
/benchmarks/             export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.php-cs-fixer.dist.php   export-ignore
/phpstan.neon.dist        export-ignore
/phpunit.xml.dist         export-ignore
/.release-please-manifest.json export-ignore
/release-please-config.json    export-ignore
/CONTRIBUTING.md         export-ignore
/CLAUDE.md               export-ignore
/CONTEXT.md              export-ignore
/examples/               export-ignore
/mkdocs.yml              export-ignore
/mkdocs_hooks.py         export-ignore
/.pre-commit-config.yaml export-ignore
